{
  "name": "leadsedge-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node dist/standalone/server.js",
    "build:frankfurt": "node --env-file=.env.frankfurt.local node_modules/vinext/dist/cli.js build",
    "start:frankfurt": "node --env-file=.env.frankfurt.local dist/standalone/server.js",
    "verify:backend": "node scripts/verify-backend.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern work",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "signin:frankfurt": "node --env-file=.env.frankfurt.local scripts/create-sign-in-link.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.104.0",
    "next": "^16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.24.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "allowScripts": {
    "sharp@0.35.4": true,
    "unrs-resolver@1.12.2": true
  }
}
