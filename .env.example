# Public Supabase project URL and anonymous browser key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anonymous-key

# Server-only Supabase service-role key. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin used in auth redirects and branded invitation links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional email delivery. Supabase remains functional without these.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Authenticated automation endpoint used to drain the durable email queue.
# Configure an external scheduler to call /api/cron/automation every minute with
# Authorization: Bearer <CRON_SECRET>. Supabase Cron still activates due forms.
CRON_SECRET=

# Optional Google Calendar web-server OAuth integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect: http://localhost:3000/api/admin/calendar/google/callback
# Use a long random value. It is hashed into an AES-256 key server-side.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Development only: expose minute-scale feedback delays for acceptance testing.
LEADSEDGE_ENABLE_MINUTE_FEEDBACK_DELAYS=false

# Demo records are available only when this is explicitly true.
LEADSEDGE_DEMO_MODE=false
